# Copy this file to .env and set every value. .env is never committed.
#
# Every variable the deployment refuses to start without is listed here, and none
# of those has a default. A stack that silently starts on a value nobody chose is
# a stack whose configuration lives in somebody's memory.
#
# Two variables are not in that group, because only a laptop reads them and
# neither can be wrong in a way that matters: ORO_MOCK_PORT, which is not listed
# here at all and defaults to 4010, and ORO_IDENTITY_PORT, which is listed
# because a volunteer opens it in a browser and defaults to 8180.

# The hostname Caddy serves. localhost on a laptop. On a real deployment this is
# the name that resolves to the host.
#
# The deployment serves a second name under it, id.HOSTNAME, for the identity
# service. That name needs its own record pointing at the same host. If
# ORO_TLS below is an email address, it also needs to resolve from the internet
# before Caddy can get a certificate for it, and Caddy reports healthy while
# failing to: the hostname works and id. does not, which reads as a routing
# fault and is a DNS one.
ORO_HOSTNAME=localhost

# How Caddy gets its certificate. Two settings are meaningful:
#
#   internal            Caddy's own local authority. A laptop, or a LAN with no
#                       public DNS. Browsers will not trust it until the root is
#                       installed on the machine doing the browsing.
#   you@example.org     An email address, which Caddy uses as the ACME account
#                       contact to get a publicly trusted certificate. Needs the
#                       hostname above to resolve from the internet and port 80
#                       reachable.
#
# The deployment reads this. make development does not: a laptop serves plain
# HTTP and asks for no certificate at all, so nothing there reads the value.
# Compose still requires the line. ADR 0003 says why the two differ.
ORO_TLS=internal

# Ports on the host that Caddy binds. 80 and 443 for a real deployment, and ACME
# needs 80. Change them when something on the machine already holds those ports.
#
# Caddy cannot see the mapping, so on a deployment moved to any other port its
# redirect from HTTP to HTTPS names the standard port rather than the one set
# here, and lands nowhere. Go straight to the HTTPS port when you have moved
# these.
#
# make development is not affected. It serves plain HTTP on the first of these
# and redirects nothing, so the port you set is the port you open.
#
# The identity service is not on either of them. On a deployment it answers
# under id. on the HTTPS port; on a laptop it has ORO_IDENTITY_PORT below.
ORO_HTTP_PORT=80
ORO_HTTPS_PORT=443

# The Postgres superuser password. Generate one and paste it after the equals
# sign.
#
#   openssl rand -base64 24
#
# Deliberately empty. A password that ships with the repository is a password
# every reader of the repository knows, and a stack that starts on one never
# tells the operator they are still using it. Compose refuses to start while
# this is empty, and the error it prints names this variable.
ORO_DB_PASSWORD=

# The password the members API logs in to Postgres with, as oro_api_login.
# db/apply-the-schema.sh creates that role with this value the first time the
# stack starts, so changing it later means changing the role too, and the
# schema service says so when it runs. Generate one and paste it in.
#
#   openssl rand -hex 24
#
# Hex rather than base64, which is what every other password here asks for. This
# one is pasted into a database URL in compose.api.yaml, and base64 can produce
# a slash, which ends the userinfo part of a URL and leaves the API trying to
# log in with half a password.
#
# It is a separate secret from ORO_DB_PASSWORD because the API is never handed
# the superuser password. The role it names holds nothing at all until each
# transaction runs SET LOCAL ROLE oro_api, which services/api/oro_api_login.sql
# explains where it creates the role.
ORO_API_DB_PASSWORD=

# The identity service, which is Zitadel today.
# docs/decisions/0004-identity-service.md says why, and what would change it.

# The login the identity service uses on the Postgres server above, and the
# password on the database it owns. db/init/001_identity_role.sql creates the
# role with this value the first time the database is initialised, so changing
# it later means changing the role too. Generate one and paste it in.
#
#   openssl rand -base64 24
#
# It is a separate secret from ORO_DB_PASSWORD on purpose: the identity service
# is never handed the superuser password. Two services read this one, and they
# read it for different reasons. The database reads it once, during first
# initialisation, to create the role. The identity service reads it to log in as
# that role. Nothing else ever sees it, and nothing at all except the database
# container sees ORO_DB_PASSWORD.
ORO_IDENTITY_DB_PASSWORD=

# Exactly 32 bytes, and it encrypts every secret the identity service stores:
# client secrets, machine keys, and the signing keys behind every token. Lose it
# and the identity database cannot be read, so it is backed up wherever the
# database dump goes and never only there.
#
#   openssl rand -hex 16
#
ORO_IDENTITY_MASTERKEY=

# The first human account on the identity service, with the rights to
# administer it. It exists so the deployment can be brought up from
# configuration alone with nothing typed into a console.
#
# The username is a login name, not an email address, unless you make it one.
# The account is asked to change its password at first sign in, so this value
# stops being the credential once somebody signs in. Until then it is a live
# administrator password sitting in a file, and nothing in this repository makes
# anybody sign in yet. Treat it as a real secret, not as a placeholder.
ORO_IDENTITY_ADMIN_USERNAME=
ORO_IDENTITY_ADMIN_PASSWORD=

# The port make development publishes the identity service on, loopback only.
# The deployment publishes nothing and is reached through Caddy at
# id.ORO_HOSTNAME. A laptop cannot do that: id.localhost does not resolve
# without an entry in /etc/hosts, and asking a volunteer to edit that file is
# the same friction ADR 0003 refused for certificates. So a laptop opens
# http://localhost on this port, with nothing to accept and nothing to add.
ORO_IDENTITY_PORT=8180
